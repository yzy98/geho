{
  "name": "@geho/widget-react",
  "version": "0.0.1",
  "description": "React chat widget SDK for Geho",
  "keywords": [
    "ai",
    "chatbot",
    "react",
    "rag",
    "self-hosted",
    "website-widget"
  ],
  "homepage": "https://github.com/yzy98/geho#readme",
  "bugs": {
    "url": "https://github.com/yzy98/geho/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzy98/geho.git",
    "directory": "packages/widget-react"
  },
  "type": "module",
  "private": false,
  "license": "LGPL-3.0-or-later",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.33",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "ai": "^7.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.20.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.16"
  }
}
